{
  "services": {
    "frontend": { "root": "frontend/", "framework": "create-react-app" },
    "backend": { "root": "backend/", "framework": "express" }
  },
  "rewrites": [
    { "source": "/_/backend/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
